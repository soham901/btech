ass=\"project-box\">\n                    <img src=\"assets/images/projects/1.jpg\" alt=\"\" />\n                    <div class=\"project-layer\">\n                        <h4>Coming Soon</h4>\n                        <p>\n                            Lorem ipsum dolor sit amet consectetur adipisicing\n                            elit. Consequatur, at!\n                        </p>\n                        <!-- <a href=\"#\"><i class=\"bx bx-link-external\"></i></a> -->\n                    </div>\n                </div>\n                <div class=\"project-box\">\n                    <img src=\"assets/images/projects/1.jpg\" alt=\"\" />\n                    <div class=\"project-layer\">\n                        <h4>Coming Soon</h4>\n                        <p>\n                            Lorem ipsum dolor sit amet consectetur adipisicing\n                            elit. Consequatur, at!\n                        </p>\n                        <!-- <a href=\"#\"><i class=\"bx bx-link-external\"></i></a> -->\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- END : projects section design -->\n\n        <!-- START : services section design -->\n        <section class=\"services\" id=\"services\">\n            <h2 class=\"heading\">Our <span>Services</span></h2>\n\n            <div class=\"services-container\">\n                <div class=\"services-box\">\n                    <i class=\"bx bx-world\"></i>\n                    <h3>Web Development</h3>\n                    <p>\n                        I specialize in creating custom web applications using\n                        Django, HTML, CSS, and JavaScript, delivering tailored\n                        solutions that meet your unique business requirements.\n                    </p>\n                    <a\n                        href=\"mailto:sagathiyasoham12345@gmail.com?subject=Web Development Inquiry\"\n                        class=\"so-btn\"\n          