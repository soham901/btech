    "data": "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\" />\n        <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n\n        <!-- START : custom css -->\n        <link rel=\"stylesheet\" href=\"assets/css/styles.css\" />\n        <!-- END : custom css -->\n\n        <!-- START : box icons css -->\n        <link\n            href=\"https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css\"\n            rel=\"stylesheet\"\n        />\n        <!-- END : box icons css -->\n\n        <!-- START : bootstrap 5 css -->\n        <link\n            href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css\"\n            rel=\"stylesheet\"\n            integrity=\"sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC\"\n            crossorigin=\"anonymous\"\n        />\n        <!-- END : bootstrap 5 css -->\n\n        <title>Portfolio | Soham</title>\n    </head>\n\n    <body>\n        <!-- START : header design -->\n        <header class=\"header\">\n            <a href=\".\" class=\"logo\">Soham</a>\n\n            <!-- <i class=\"bx bx-menu\" id=\"menu-icon\"></i> -->\n\n            <nav class=\"navbar\">\n                <a href=\"#home\" class=\"active\">home</a>\n                <a href=\"#projects\">projects</a>\n                <a href=\"#services\">services</a>\n                <a href=\"#about\">about</a>\n                <a href=\"#contact\">contact</a>\n                <a href=\"https://soham901-portfolio.vercel.app/\" style=\"background-color: var(--main-color); padding: .2rem .6rem; color: black; border-radius: .8rem;\">V3</a>\n            </nav>\n        </header>\n        <!-- END : header design -->\n\n        <!-- START : home section design -->\n        <section class=\"home\" id=\"home\">\n            <div class=\"home-content\">\n                <h3>Hello, It's Me</h3>\n              